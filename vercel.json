{
  "framework": "vite",
  "buildCommand": "npx convex dev --once && bun run build",
  "outputDirectory": "dist",
  "installCommand": "bun install --no-cache",
  "devCommand": "bun run dev",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "github": {
    "silent": true
  }
}
